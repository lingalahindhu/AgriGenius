# Anthropic Claude API Key (for LangGraph Claude Sonnet 4.6 intent routing)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenWeatherMap API Key (for live Warangal weather data)
WEATHER_API_KEY=your_weather_api_key_here

# Data.gov.in / Agmarknet API Key (for live market mandi prices)
AGMARKNET_API_KEY=your_agmarknet_api_key_here

# MongoDB Connection String (Paste your MongoDB Atlas or local URI here)
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/agri_genius?retryWrites=true&w=majority