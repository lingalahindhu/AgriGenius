# Google Gemini API key (optional; local fallback is used when blank)
GOOGLE_API_KEY=your_google_ai_api_key_here

# OpenWeatherMap API key (optional; mock weather is used when blank)
WEATHER_API_KEY=your_openweathermap_api_key_here

# Data.gov.in / Agmarknet API key (optional; mock prices are used when blank)
AGMARKNET_API_KEY=your_agmarknet_api_key_here

# MongoDB connection string (optional)
MONGODB_URI=mongodb://localhost:27017/agri_genius